#!/bin/bash
set -euo pipefail

SCRIPT_PATH="${1:-}"

case "$SCRIPT_PATH" in
  /tmp/nvidia-driver-manager-*/install-nvidia-driver.sh)
    ;;
  *)
    echo "ERROR: refused to run unexpected script path: $SCRIPT_PATH" >&2
    exit 126
    ;;
esac

if [ ! -f "$SCRIPT_PATH" ]; then
  echo "ERROR: script does not exist: $SCRIPT_PATH" >&2
  exit 127
fi

exec /usr/bin/bash "$SCRIPT_PATH"
